#!/usr/bin/env bash
# dots-update: applies the .patch files from the downloads folder to this repo, installs the
# config and reloads Hyprland + Quickshell, then pushes to GitHub. One command instead of
# git am / ./setup install-files / hyprctl reload / restarting qs by hand.
#
#   dots-update               apply new patches from the downloads folder, install, reload, push
#   dots-update a.patch ...   apply these patch files instead
#   dots-update --install     install and reload even if there is no new patch
#   dots-update --no-push     don't push to GitHub
#   dots-update --no-install  only apply the patches (no install / reload)
#   dots-update --dry-run     only show what would be done
#
# Patches already in the repo (same commit subject, or already applied) are skipped. Patches
# that don't belong to this repo (other projects) are left alone. Processed patches are moved to
# <downloads>/applied-patches so they are not looked at again.

set -u

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

push=true install=auto dry=false
files=()
for arg in "$@"; do
    case "$arg" in
        --no-push) push=false ;;
        --install) install=always ;;
        --no-install) install=never ;;
        -n|--dry-run) dry=true ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "Unknown option: $arg" >&2; usage; exit 2 ;;
        *) files+=("$(readlink -f -- "$arg")") ;;
    esac
done

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; exit 1; }
run()  { if $dry; then printf '    (dry run) %s\n' "$*"; else "$@"; fi; }

cd "$(dirname -- "$(readlink -f -- "$0")")" || die "Can't open the repo folder"
git rev-parse --git-dir >/dev/null 2>&1 || die "$(pwd) is not a git repo"

# Downloads folder (xdg-user-dir knows the localized name, e.g. ~/İndirilenler)
downloads=$(xdg-user-dir DOWNLOAD 2>/dev/null || true)
if [ -z "$downloads" ] || [ "$downloads" = "$HOME" ] || [ ! -d "$downloads" ]; then
    downloads=""
    for d in "$HOME/İndirilenler" "$HOME/Downloads"; do
        [ -d "$d" ] && { downloads=$d; break; }
    done
fi
done_dir="${downloads:-$HOME}/applied-patches"

# A previous git am that stopped half way blocks every new one
if [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
    warn "Cleaning up an unfinished git am from before"
    run git am --abort 2>/dev/null || run git am --quit
fi

# Uncommitted changes would get mixed up with the patches
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    git status --short --untracked-files=no
    die "There are uncommitted changes in $(pwd). Commit them, or put them aside with: git stash"
fi

# Patch files, oldest download first (that is the order they were made in)
if [ ${#files[@]} -eq 0 ] && [ -n "$downloads" ]; then
    while IFS= read -r -d '' line; do
        files+=("${line#* }")
    done < <(find "$downloads" -maxdepth 1 -type f -name '*.patch' -printf '%T@ %p\0' | sort -z -n)
fi

# Subject of a patch as the commit will have it: git mailinfo unfolds long subjects, decodes
# non-ASCII ones (e.g. "◇", stored encoded in the patch) and drops "[PATCH n/m]"
patch_subject() {
    git mailinfo /dev/null /dev/null <"$1" 2>/dev/null | sed -n 's/^Subject: //p' | head -n 1
}
# Does the patch touch this repo? (at least one of its paths starts with a top folder of the repo)
patch_belongs_here() {
    local path top
    while IFS= read -r path; do
        top=${path%%/*}
        [ -e "$top" ] && return 0
    done < <(sed -n 's|^diff --git a/\([^ ]*\) b/.*|\1|p' "$1")
    return 1
}

# Patches that were replaced by later ones and must never be applied (exact subjects)
obsolete_subjects='Title bars: no extra bar for the Claude desktop app
Title bars: keep the title bar on the Claude desktop app
Title bars: no second row of buttons in the Claude desktop app'

applied=0 skipped=0 processed=()
known_subjects=$(printf '%s\n%s' "$obsolete_subjects" "$(git log --format=%s -n 2000)")
for f in "${files[@]}"; do
    [ -f "$f" ] || { warn "Not found: $f"; continue; }
    name=$(basename -- "$f")
    if ! grep -q '^diff --git ' "$f" || ! patch_belongs_here "$f"; then
        [ -n "$downloads" ] && [ "$(dirname -- "$f")" = "$downloads" ] && continue # another project's patch: leave it
        die "$name is not a patch for this repo"
    fi
    subject=$(patch_subject "$f")
    if [ -n "$subject" ] && grep -Fxq -- "$subject" <<<"$known_subjects"; then
        skipped=$((skipped + 1)); processed+=("$f")
        continue
    fi
    if ! git apply --check "$f" 2>/dev/null && git apply --check -R "$f" 2>/dev/null; then
        skipped=$((skipped + 1)); processed+=("$f") # already applied under another name
        continue
    fi
    say "Applying: ${subject:-$name}"
    if $dry; then
        git apply --check "$f" 2>/dev/null || warn "    would not apply cleanly"
        applied=$((applied + 1)); processed+=("$f")
        continue
    fi
    if ! git am -3 --quiet "$f"; then
        git am --abort 2>/dev/null
        [ $applied -gt 0 ] && git log --oneline -n "$applied" | sed 's/^/    applied before it: /'
        die "$name doesn't apply (it was made for a different version of the files). This patch was not applied; send this message to Claude."
    fi
    known_subjects=$(printf '%s\n%s' "$subject" "$known_subjects")
    applied=$((applied + 1)); processed+=("$f")
done

# Move processed patches out of the way so they are not looked at again
if [ ${#processed[@]} -gt 0 ] && [ -n "$downloads" ]; then
    run mkdir -p "$done_dir"
    for f in "${processed[@]}"; do
        [ "$(dirname -- "$f")" = "$downloads" ] && run mv -f -- "$f" "$done_dir/"
    done
fi

[ $skipped -gt 0 ] && say "$skipped patch(es) were already in the repo"
if [ $applied -eq 0 ]; then
    say "No new patches"
    [ "$install" = always ] || { [ "$install" = never ] || say "(dots-update --install installs and reloads anyway)"; exit 0; }
else
    ok "$applied patch(es) applied"
    git log --oneline -n "$applied" | sed 's/^/    /'
fi

if [ "$install" != never ]; then
    say "Installing the config (./setup install-files)"
    run ./setup install-files -f || die "./setup install-files failed"
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        say "Reloading Hyprland and Quickshell"
        run hyprctl reload >/dev/null
        run pkill -x qs
        $dry || sleep 0.5
        run setsid -f qs -c "${qsConfig:-ii}" >/dev/null 2>&1
    fi
fi

if $push && [ $applied -gt 0 ]; then
    say "Pushing to GitHub"
    if $dry; then
        run git push
    elif ! timeout 60 git push --quiet; then
        warn "Push failed or timed out (network / Throne?). Your PC is up to date; run 'git push' later."
    fi
fi
ok "Done"
